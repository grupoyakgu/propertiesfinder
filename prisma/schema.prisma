// Prisma schema for PropertiesFinder — Spanish land & development acquisition platform

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum CadastralClass {
  URBANO
  RUSTICO
}

enum LandUse {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  AGRICULTURAL
  TOURISM
  MIXED
  OTHER
}

enum OpportunityStatus {
  IN_REVIEW
  NOT_RELEVANT
  VALIDATED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  // Admins get a dashboard-only "Admin" tab for managing all users. There is no
  // UI to grant/revoke this — the only admin promotion path is a direct DB
  // update (see the add_user_admin_permissions migration's data fix for the
  // one-time bootstrap of the first admin).
  isAdmin      Boolean  @default(false)
  // A disabled user is treated as logged out everywhere getCurrentUser() is
  // used (every route/page already gates on that), and is blocked from
  // logging back in at all.
  isActive     Boolean  @default(true)
  // Feature flags an admin can grant/revoke per user — see src/lib/permissions.ts
  // for the known set. Defaults to granting every current permission so existing
  // users keep working unchanged; an admin can then selectively revoke.
  permissions  String[] @default(["analysis_engine"])
  // Persisted dashboard preferences, restored on the user's next visit — see
  // MapDisplaySettings and the "Settings" tab. mapLocked: panning the map no
  // longer re-scopes the Official Catastro Records table/map markers to the
  // new viewport. showAllOnMap: every matching property renders on the map
  // automatically instead of only manually-picked ones.
  mapLocked    Boolean  @default(false)
  showAllOnMap Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  opportunities     Favorite[]
  mapPresets        MapPreset[]
  comments          Comment[]
  analysisResults   AnalysisResult[]
  analysisSummaries AnalysisSummary[]

  @@map("users")
}

// Official cadastral parcels bulk-imported from Catastro's INSPIRE download
// services (Cadastral Parcels + Buildings themes) — real government registry
// records with no price/ROI/zoning judgment, physical and legal facts only.
model CatastroParcel {
  id                  String  @id @default(cuid())
  referenciaCatastral String  @unique
  municipality        String
  province            String
  autonomousCommunity String
  latitude            Float
  longitude           Float
  boundary            Json // GeoJSON polygon, reprojected to WGS84
  streetName          String? // Thoroughfare name, from the Addresses (AD) theme
  streetNumber        String? // House number (designator), from the Addresses (AD) theme

  plotSize         Float // Superficie del terreno (m2), from CP geometry
  builtArea        Float? // Superficie construida (m2), summed from joined BU footprints
  constructionYear Int? // Año de construcción, from BU
  numberOfFloors   Int? // From BU
  cadastralUse     CadastralClass // Clase de inmueble (URBANO/RUSTICO)
  landUse          LandUse? // Uso principal; null if the source code doesn't map cleanly

  sourceDataset String // e.g. "INSPIRE-CP-BU", for traceability
  importedAt    DateTime @default(now())

  analysisResults   AnalysisResult[]
  analysisSummaries AnalysisSummary[]

  @@index([municipality, province])
  @@index([latitude, longitude])
  @@map("catastro_parcels")
}

// A shared "Opportunity": a CatastroParcel someone has flagged worth further
// exploration. One row per property (not per user) — liking it from anywhere
// in the app adds it here, un-liking removes it outright, regardless of who's
// currently assigned. source + propertyId (rather than a direct foreign key)
// is a holdover from when a second property table also existed; kept as-is
// since it's a harmless shape for a single source and avoids an unnecessary
// migration.
model Favorite {
  id             String            @id @default(cuid())
  // Who's currently responsible for exploring this opportunity — defaults to
  // whoever added it, but any signed-in user can reassign it to anyone else.
  assignedUserId String
  source         String // "catastro"
  propertyId     String // CatastroParcel.id
  status         OpportunityStatus @default(IN_REVIEW)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  assignedUser User @relation(fields: [assignedUserId], references: [id], onDelete: Cascade)

  @@unique([source, propertyId])
  @@map("favorites")
}

// A user-authored note on a CatastroParcel. Same source + propertyId shape as
// Favorite, for the same reason.
model Comment {
  id         String   @id @default(cuid())
  userId     String
  source     String // "catastro"
  propertyId String // CatastroParcel.id
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([source, propertyId])
  @@map("comments")
}

// A saved map viewport (pan/zoom bounding box), named by the user, so they can
// jump back to a frequently-used area instead of re-panning/zooming manually.
// One preset per user may be marked isDefault, applied automatically when the
// dashboard loads with no other viewport already specified (e.g. via a "back
// to search" bbox).
model MapPreset {
  id        String   @id @default(cuid())
  userId    String
  name      String
  south     Float
  west      Float
  north     Float
  east      Float
  // The dashboard's full search filter state (location, land characteristics, etc.)
  // at save time, so applying a preset restores the search, not just the viewport.
  // Nullable so presets created before this field existed still load fine.
  filters   Json?
  // An optional hand-drawn area (GeoJSON Polygon, WGS84) — when present, applying
  // this preset restricts the Official Catastro Records table/map to parcels whose
  // point falls inside it, not just within south/west/north/east (which is still
  // kept, as the polygon's bounding box, so the map still knows where to fit).
  polygon   Json?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("map_presets")
}

// The most recent successful Analysis Engine result for a given user/parcel/mode,
// so the full report and residual-land-value summary table are still there when
// the user comes back — no need to re-run the (slow, costly) AI analysis just to
// look at a result they already generated. Only successful runs are persisted
// (see the API route): a failed re-run doesn't clobber a previously saved good
// result for that mode.
model AnalysisResult {
  id       String @id @default(cuid())
  userId   String
  parcelId String
  mode     String // "knowledge" | "web"
  report   String
  data     Json? // AnalysisEngineData shape — see src/lib/analysis-engine.ts

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parcel CatastroParcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  @@unique([userId, parcelId, mode])
  @@map("analysis_results")
}

// A normalized, queryable copy of just the Residual Land Value Engine's headline
// numbers (the ones shown in the summary table under each mode's report) —
// deliberately a separate table from AnalysisResult's report/full-JSON blob, so
// this specific figure set has its own durable, independently-readable home
// rather than living only inside a JSON column. Written alongside AnalysisResult
// on every successful run, same one-per-user/parcel/mode upsert semantics.
model AnalysisSummary {
  id       String @id @default(cuid())
  userId   String
  parcelId String
  mode     String // "knowledge" | "web"

  commercialUseAllowed       String
  touristUseAllowed          String
  grossBuildableArea         String
  saleableArea               String
  estimatedResidentialUnits  String
  estimatedHotelRooms        String
  estimatedTouristApartments String
  constructionCostPerSqm     String
  grossDevelopmentValue      String
  developerMargin            String
  residualLandValue          String
  highestAndBestUse          String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parcel CatastroParcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  @@unique([userId, parcelId, mode])
  @@map("analysis_summaries")
}
