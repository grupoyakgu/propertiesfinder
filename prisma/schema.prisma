// Prisma schema for PropertiesFinder — Spanish land & development acquisition platform

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum CadastralClass {
  URBANO
  RUSTICO
}

enum PlotShape {
  REGULAR
  IRREGULAR
  RECTANGULAR
  TRIANGULAR
  L_SHAPED
  CORNER
}

enum PlanningStatus {
  URBAN
  DEVELOPABLE
  RURAL
  PROTECTED
  HISTORIC
}

enum DevelopmentPotential {
  RESIDENTIAL
  HOTEL
  APARTHOTEL
  COMMERCIAL
  MIXED_USE
  OFFICE
  STUDENT_HOUSING
  SENIOR_LIVING
  LOGISTICS
}

enum Topography {
  FLAT
  SLOPED
}

enum LandUse {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  AGRICULTURAL
  TOURISM
  MIXED
  OTHER
}

enum BuildingType {
  DETACHED_HOUSE
  TERRACED_HOUSE
  APARTMENT_BLOCK
  VILLA
  WAREHOUSE
  OFFICE_BUILDING
  HOTEL_BUILDING
  COMMERCIAL_BUILDING
  VACANT_PLOT
  OTHER
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  favorites  Favorite[]
  mapPresets MapPreset[]

  @@map("users")
}

model Plot {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---- General information ----
  address             String
  municipality        String
  province            String
  autonomousCommunity String
  postalCode          String?
  latitude            Float
  longitude           Float
  referenciaCatastral String  @unique
  imageUrl            String?
  description         String?

  // ---- Land characteristics ----
  plotSize          Float // Superficie del terreno (m2)
  builtArea         Float          @default(0) // Superficie construida (m2)
  superficieGrafica Float? // Superficie grafica (m2), from Catastro cartography
  constructionYear  Int?
  landUse           LandUse
  cadastralUse      CadastralClass
  buildingType      BuildingType
  numberOfFloors    Int            @default(0)
  maxBuildableArea  Float // Maximum allowed buildability (m2)
  buildabilityRatio Float // Edificabilidad (m2 buildable / m2 plot)
  occupancyRatio    Float // % of plot that may be occupied by footprint
  plotShape         PlotShape
  cornerPlot        Boolean        @default(false)
  frontageWidth     Float
  depth             Float

  // ---- Official cadastral fields ----
  valorCatastral Float // Valor catastral (EUR)

  // ---- Planning information ----
  planningStatus       PlanningStatus
  developmentPotential DevelopmentPotential[]
  allowedUses          String[]
  maxHeight            Float? // meters
  restrictions         String[]
  zoning               String? // e.g. plan parcial / normativa reference

  // ---- Investment ----
  purchasePrice             Float
  pricePerSqm               Float
  estimatedConstructionCost Float?
  expectedROI               Float? // %
  expectedYield             Float? // %
  developmentMargin         Float? // %

  // ---- Physical characteristics ----
  topography         Topography
  doubleFrontage     Boolean    @default(false)
  existingBuilding   Boolean    @default(false)
  demolitionRequired Boolean    @default(false)
  vacantLand         Boolean    @default(false)

  // ---- Map ----
  boundary        Json? // GeoJSON polygon of plot boundary
  nearbyAmenities String[]

  // ---- AI analysis cache ----
  aiScore      Float?
  aiSummary    String?
  aiAnalyzedAt DateTime?

  @@index([latitude, longitude])
  @@map("plots")
}

// Official cadastral parcels bulk-imported from Catastro's INSPIRE download
// services (Cadastral Parcels + Buildings themes). Unlike Plot, these are
// real government registry records with no price/ROI/zoning judgment —
// physical and legal facts only.
model CatastroParcel {
  id                  String   @id @default(cuid())
  referenciaCatastral String   @unique
  municipality        String
  province            String
  autonomousCommunity String
  latitude            Float
  longitude           Float
  boundary            Json // GeoJSON polygon, reprojected to WGS84
  streetName          String? // Thoroughfare name, from the Addresses (AD) theme
  streetNumber        String? // House number (designator), from the Addresses (AD) theme

  plotSize         Float // Superficie del terreno (m2), from CP geometry
  builtArea        Float? // Superficie construida (m2), summed from joined BU footprints
  constructionYear Int? // Año de construcción, from BU
  numberOfFloors   Int? // From BU
  cadastralUse     CadastralClass // Clase de inmueble (URBANO/RUSTICO)
  landUse          LandUse? // Uso principal; null if the source code doesn't map cleanly

  sourceDataset String // e.g. "INSPIRE-CP-BU", for traceability
  importedAt    DateTime @default(now())

  @@index([municipality, province])
  @@index([latitude, longitude])
  @@map("catastro_parcels")
}

// A user's "liked" property. Polymorphic across the two property tables (sample
// Plot listings and official CatastroParcel records) via source + propertyId
// rather than a direct foreign key, since a favorite can point at either one.
model Favorite {
  id         String   @id @default(cuid())
  userId     String
  source     String // "plots" | "catastro"
  propertyId String // Plot.id or CatastroParcel.id, depending on source
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, propertyId])
  @@map("favorites")
}

// A saved map viewport (pan/zoom bounding box), named by the user, so they can
// jump back to a frequently-used area instead of re-panning/zooming manually.
// One preset per user may be marked isDefault, applied automatically when the
// dashboard loads with no other viewport already specified (e.g. via a "back
// to search" bbox).
model MapPreset {
  id        String   @id @default(cuid())
  userId    String
  name      String
  south     Float
  west      Float
  north     Float
  east      Float
  // The dashboard's full search filter state (location, land characteristics, etc.)
  // at save time, so applying a preset restores the search, not just the viewport.
  // Nullable so presets created before this field existed still load fine.
  filters   Json?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("map_presets")
}
