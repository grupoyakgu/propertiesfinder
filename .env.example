# Supabase
NEXT_SUPABASE_URL="https://your-project.supabase.co"
NEXT_SUPABASE_ANON_KEY="your_anon_key"

# App
NEXT_APP_URL="http://localhost:3000"

# Session auth — set to a long random string in production
SESSION_SECRET="change-me"

# Sede Electronica del Catastro official OVC web services (public, no key required)
CATASTRO_CALLEJERO_URL="https://ovc.catastro.meh.es/ovcservweb/OVCSWLocalizacionRC/OVCCallejero.asmx"
CATASTRO_COORDENADAS_URL="https://ovc.catastro.meh.es/ovcservweb/OVCSWLocalizacionRC/OVCCoordenadas.asmx"

# Anthropic API key, used by the Analysis Engine tab to run AI-powered urban
# planning feasibility analysis (src/lib/analysis-engine.ts)
ANTHROPIC_API_KEY=""
